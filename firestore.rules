rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Eski tek mağaza atamaları (assignedStoreId) korunur. Yeni kullanıcılar için
    // assignedStoreIds dizisiyle birden fazla mağazaya erişim verilebilir.
    function canUseStore(storeId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return profile.role == "admin" || profile.assignedStoreId == storeId ||
        (profile.keys().hasAny(["assignedStoreIds"]) && profile.assignedStoreIds.hasAny([storeId]));
    }

    // ---- users: herkes okuyabilir, kendi belgesini (role:"user", assignedStoreId:"")
    // olarak oluşturabilir, ama sadece admin bir kullanıcının rolünü / mağaza atamasını
    // güncelleyebilir. ----
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (request.auth != null && request.auth.uid == userId
        && request.resource.data.role == "user"
        && request.resource.data.assignedStoreId == "");
      allow update: if isAdmin();
      // Kullanıcı profilleri yalnızca admin tarafından silinebilir. Bu, stok,
      // satış ve ciro kayıtlarını değil sadece /users altındaki erişim profilini siler.
      allow delete: if isAdmin();
    }

    // ---- ciro: admin her mağazayı ekleyip silebilir; personel sadece kendine
    // atanmış mağazanın kaydını ekleyip silebilir. Okuma herkese açık (uygulama
    // zaten sorguyu personel için kendi mağazasıyla sınırlıyor). ----
    match /ciro/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && canUseStore(request.resource.data.storeId);
      allow delete: if request.auth != null && canUseStore(resource.data.storeId);
      allow update: if false;
    }

    // ---- kasaDefteri: ciro ile birebir aynı mantık. ----
    match /kasaDefteri/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && canUseStore(request.resource.data.storeId);
      allow delete: if request.auth != null && canUseStore(resource.data.storeId);
      allow update: if false;
    }

    // ---- Kalan her şey (mağazalar, ürünler, kategoriler, teşhir ürünleri):
    // giriş yapan herkes okuyup yazabilir — eskisi gibi. ----
    match /stores/{storeId} {
      allow read, write: if request.auth != null;

      match /products/{productId} {
        allow read, write: if request.auth != null;
      }
    }

    match /categories/{categoryId} {
      allow read, write: if request.auth != null;
    }

    match /showroomProducts/{productId} {
      allow read, write: if request.auth != null;
    }

    // Weltew genel stok: yalnızca mevcut elit hesabı. Diğer adminler de erişemez.
    function isWeltewOwner() {
      return request.auth != null
        && request.auth.token.email == 'elit@elithome.local';
    }
    match /weltewInventory/main/products/{productId} {
      allow read: if isWeltewOwner();
      allow create, update: if isWeltewOwner()
        && request.resource.data.name is string
        && request.resource.data.sku is string
        && request.resource.data.qty is number
        && request.resource.data.qty >= 0
        && request.resource.data.buy is number
        && request.resource.data.buy >= 0;
      allow delete: if false;
    }
    match /weltewInventory/main/movements/{movementId} {
      allow read: if isWeltewOwner();
      allow create: if isWeltewOwner()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.before is number
        && request.resource.data.after is number
        && request.resource.data.after >= 0;
      allow update, delete: if false;
    }
  }
}
